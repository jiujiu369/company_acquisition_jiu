# Server-only credentials. Never paste the key into a product URL or the browser UI.
SCRAPERAPI_KEY=
SCRAPERAPI_ENABLED=false
# Timeout in seconds; bounded attempts for transient HTTP/network errors (1-3).
SCRAPERAPI_TIMEOUT=70
SCRAPERAPI_MAX_ATTEMPTS=2
# Optional existing Chrome session; otherwise use data/playwright/taobao_profile.
# AI_ECOMMERCE_CHROME_CDP_URL=http://127.0.0.1:9222
# AI_ECOMMERCE_DATA_DIR=D:/AI_Ecommerce/data
